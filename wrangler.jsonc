      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "hisabi-11772.firebaseapp.com",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "hisabi-11772",
      "MUSHAF_FONT_PACK_URL": "http://lalithasaram.net/downloads/qfonts/",
      "NEXT_PUBLIC_QURAN_API_URL": "https://api.quran.com/api/v4",
      "NEXT_PUBLIC_QURAN_RECITER_ID": "7",
